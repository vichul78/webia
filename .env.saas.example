# SaaS runtime settings
APP_NAME="Your SaaS Name"
APP_URL="https://app.example.com"

# Auth (recommended: Clerk/Auth0/Supabase Auth)
AUTH_PROVIDER="clerk"
AUTH_SECRET="replace_me"
AUTH_PUBLIC_KEY="replace_me"

# Database and tenancy
DATABASE_URL="postgresql://user:pass@localhost:5432/webia"
TENANCY_MODE="row-level-security"

# Billing (Stripe)
STRIPE_SECRET_KEY="sk_live_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_PRICE_FREE="price_xxx_free"
STRIPE_PRICE_PRO="price_xxx_pro"
STRIPE_PRICE_ENTERPRISE="price_xxx_enterprise"

# AI providers
OPENAI_API_KEY="sk-..."
OPENAI_BASE_URL=""
GEMINI_API_KEY=""
GOOGLE_API_KEY=""
ANTHROPIC_API_KEY=""

# Security
SESSION_COOKIE_SECURE="true"
SESSION_COOKIE_SAMESITE="lax"
CSRF_SECRET="replace_me"
